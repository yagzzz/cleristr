# Application
NODE_ENV=development
APP_URL=http://localhost:3000
PAYTR_CALLBACK_URL=http://localhost:3000/api/payments/paytr/callback
DATABASE_URL=file:./data/cleris.db
DATABASE_AUTH_TOKEN=
SESSION_COOKIE_NAME=cleris_session
CRON_SECRET=replace-with-a-long-random-value
FIELD_ENCRYPTION_KEY=

# PAYTR - server side only
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
PAYTR_DEBUG_ON=1
PAYTR_TIMEOUT_MINUTES=30

# Google OAuth - optional until Google sign-in is activated
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Provider defaults. Safe local adapters write to logs only.
EMAIL_PROVIDER=console
EMAIL_FROM=CLERIS <no-reply@cleristr.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=

# Media storage
MEDIA_STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional tracking IDs. Scripts remain consent-gated.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=
